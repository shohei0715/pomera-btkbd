    "95 01 75 08 81 01",                                # 予約 1byte
    "95 05 75 01 05 08 19 01 29 05 91 02",              # LED出力 5bit
    "95 01 75 03 91 01",                                # パディング 3bit
    "95 06 75 08 15 00 26 ff 00 05 07 19 00 29 ff 81 00",  # キー 6byte (英数/かな=0x90/0x91を含むよう0xFFまで)
    "c0",
    # レポートID 2: Consumer Control 16bit (地球儀キー=AC Next Keyboard Layout Select 0x029D を送る用)
    "05 0c 09 01 a1 01 85 02 15 00 26 ff 03 19 00 2a ff 03 75 10 95 01 81 00 c0",
