#!/usr/bin/python3
# pomera-btkbd: ポメラをBluetoothキーボード(クラシックHID)にする常駐デーモン。
# keydで大西配列に入れ替えた後の「keyd virtual keyboard」を読み、相手端末へ送る。
#   remoteモード: 入力デバイスを独占(EVIOCGRAB)してポメラ自身には文字を入れない
#   localモード : 何もしない(ポメラで普通に使う)
# 操作は /run/pomera-btkbd/cmd (FIFO) に toggle / remote / local / pair を書く(btkbdコマンド経由)。
# 状態は /run/pomera-btkbd/state に1行で出す(screenのステータス表示用)。
import fcntl, os, socket, struct, subprocess, sys, threading, time
import dbus, dbus.service
from dbus.mainloop.glib import DBusGMainLoop
from gi.repository import GLib

RUN = "/run/pomera-btkbd"
STATE_FILE = RUN + "/state"
CMD_FIFO = RUN + "/cmd"
HOST_FILE = "/var/lib/pomera-btkbd/host"
SAVED_BL = RUN + "/brightness"
PSM_CTRL, PSM_INTR = 0x11, 0x13
EVIOCGRAB = 0x40044590
PAIR_SECONDS = 120

# ブートキーボード(レポートID 1)+LED出力
